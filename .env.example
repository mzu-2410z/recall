# =============================================================================
# Recall — Environment Variables
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local or any file with real secrets.
# =============================================================================

# ── Supabase ──────────────────────────────────────────────────────────────────
# Your Supabase project URL (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Public anon key — safe to expose in browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Service role key — SERVER SIDE ONLY, never expose to browser
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── Google OAuth ──────────────────────────────────────────────────────────────
# From Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# OAuth redirect URI — must match exactly what you set in Google Cloud Console
# Local: http://localhost:3000/api/auth/callback/google
# Production: https://your-vercel-app.vercel.app/api/auth/callback/google
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google

# ── Groq ─────────────────────────────────────────────────────────────────────
# Get your key at: https://console.groq.com
GROQ_API_KEY=gsk_your-groq-api-key

# Groq model for chat/completion (Llama 3.3 70B recommended)
GROQ_MODEL=groq/compound

# Groq model for transcription (Whisper large v3)
GROQ_WHISPER_MODEL=whisper-large-v3

# ── Application ───────────────────────────────────────────────────────────────
# Public URL of your app (no trailing slash)
# Local:      http://localhost:3000
# Production: https://your-vercel-app.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secret for signing share tokens etc. Generate with: openssl rand -base64 32
APP_SECRET=your-random-32-char-secret-here

# ── Resend (optional — email summaries) ──────────────────────────────────────
# Get your key at: https://resend.com
RESEND_API_KEY=re_your-resend-api-key
RESEND_FROM_EMAIL=noreply@yourdomain.com

# ── Rate Limiting (optional overrides) ────────────────────────────────────────
# Max AI requests per user per hour
RATE_LIMIT_AI_RPH=20

# Max upload size in bytes (default 500MB)
MAX_UPLOAD_BYTES=524288000

# ── Assessment Demo Mode ──────────────────────────────────────────────────────
# Set to true to enable deterministic demo data for Google Calendar/Meet
DEMO_MODE=false
